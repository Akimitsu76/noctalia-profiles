#!/usr/bin/env python3
"""noctalia-widget-frames — moldura gótico-dark automática via stickers PNG.

Modo incremental (padrão): só gera molduras para widgets novos, remove obsoletas,
atualiza stickers redimensionados. Não toca em molduras corretas.
Modo --full: remove todas e recria.

Excluídos (sem fundo nem borda):
  - victor/fastfetch-desktop:*, tausif/ncs-visualizer:*
  - audio_visualizer, fancy_audio_visualizer

Moldura: borda externa 3px #6b0f2a, interna 2px #8a1230, cantos retos.
Stickers de foto/gif: box ajustado para proporção exata da imagem.
"""
import os, re, sys, hashlib, fcntl, subprocess
from pathlib import Path

try:
    from PIL import Image, ImageDraw
except ImportError:
    sys.exit("Pillow necessário: pip install --user Pillow")

HOME = Path(os.environ.get("HOME", Path.home()))
SETTINGS = HOME / ".local" / "state" / "noctalia" / "settings.toml"
FRAMES_DIR = HOME / ".local" / "state" / "noctalia" / "frames"

EXCLUDE_PREFIXES = (
    "victor/fastfetch-desktop:",
    "victor/profiles:sticker",  # moldura nativa via ui.column
    "victor/profiles:label",    # moldura nativa via ui.column
    "tausif/ncs-visualizer:",
)
EXCLUDE_TYPES = ("audio_visualizer", "fancy_audio_visualizer")
FRAME_PREFIX = "gothic-frame-"

OUTER_COLOR = (0x6b, 0x0f, 0x2a, 255)
INNER_COLOR = (0x8a, 0x12, 0x30, 255)
OUTER_W, INNER_W = 3, 2

# conteúdo encosta na borda (sem afastamento interno)
BACKGROUND_PADDING = 0

INVALID_KEYS = (
    "background_border", "background_border_width",
    "background_inner_border", "background_inner_border_width",
    "border", "border_width", "border_color",
)

HEADER_RE = re.compile(r"^\s*\[([^\]]+)\]\s*$")
WIDGET_RE = re.compile(r"^desktop_widgets\.widget\.([^.]+)$")
SETTINGS_RE = re.compile(r"^desktop_widgets\.widget\.([^.]+)\.settings$")
KV_RE = re.compile(r"^(\s*)([A-Za-z0-9_-]+)(\s*=\s*)(.*)$")
TYPE_RE = re.compile(r'^\s*type\s*=\s*"([^"]+)"')


def is_excluded(wtype):
    return wtype in EXCLUDE_TYPES or any(wtype.startswith(p) for p in EXCLUDE_PREFIXES)


def frame_hash(w, h):
    return hashlib.md5(f"{int(w)}x{int(h)}:{OUTER_COLOR}:{INNER_COLOR}".encode()).hexdigest()[:8]


def gen_frame_png(path, w, h):
    w, h = int(w), int(h)
    if w < 10 or h < 10:
        w, h = max(w, 10), max(h, 10)
    img = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    d.rectangle([0, 0, w - 1, h - 1], outline=OUTER_COLOR, width=OUTER_W)
    d.rectangle([OUTER_W, OUTER_W, w - 1 - OUTER_W, h - 1 - OUTER_W], outline=INNER_COLOR, width=INNER_W)
    img.save(path, "PNG")


def parse_widgets(lines):
    headers = [(n, HEADER_RE.match(ln.rstrip("\n")).group(1))
               for n, ln in enumerate(lines) if HEADER_RE.match(ln.rstrip("\n"))]
    widgets = {}
    for pos, (n, name) in enumerate(headers):
        mw = WIDGET_RE.match(name)
        if mw:
            wid = mw.group(1)
            end = headers[pos + 1][0] if pos + 1 < len(headers) else len(lines)
            w = {"header": n, "end": end, "type": ""}
            for ln in lines[n + 1:end]:
                mt = TYPE_RE.match(ln)
                if mt: w["type"] = mt.group(1)
                for key in ("cx", "cy", "box_width", "box_height", "output"):
                    mk = re.match(r'^\s*' + key + r'\s*=\s*(.+)', ln)
                    if mk:
                        val = mk.group(1).strip().strip('"')
                        try: w[key] = float(val) if key != "output" else val
                        except ValueError: w[key] = val
            widgets[wid] = w
    for pos, (n, name) in enumerate(headers):
        ms = SETTINGS_RE.match(name)
        if ms:
            wid = ms.group(1)
            end = headers[pos + 1][0] if pos + 1 < len(headers) else len(lines)
            if wid in widgets:
                widgets[wid].update(settings=n, settings_end=end)
                # ler image_path e background
                for ln in lines[n + 1:end]:
                    mi = re.match(r'^\s*image_path\s*=\s*"([^"]+)"', ln)
                    if mi: widgets[wid]["image_path"] = mi.group(1)
                    mb = re.match(r'^\s*background\s*=\s*(true|false)', ln)
                    if mb: widgets[wid]["background"] = mb.group(1) == "true"
                    for key in ("image_width", "image_height"):
                        mk = re.match(r'^\s*' + key + r'\s*=\s*([0-9.]+)', ln)
                        if mk:
                            try: widgets[wid][key] = float(mk.group(1))
                            except ValueError: pass
    return widgets


def remove_widget(lines, wid, widgets):
    """Remove um widget (header + settings) do lines."""
    w = widgets.get(wid)
    if not w: return lines
    ranges = []
    if "settings" in w:
        ranges.append((w["settings"], w["settings_end"]))
    ranges.append((w["header"], w["end"]))
    for start, end in sorted(ranges, reverse=True):
        del lines[start:end]
    return lines


def main():
    full = "--full" in sys.argv
    FRAMES_DIR.mkdir(parents=True, exist_ok=True)
    # file lock para evitar corrida com path unit / Noctalia
    lock_path = FRAMES_DIR / ".lock"
    lock_fd = open(lock_path, "w")
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("outra instância rodando — saindo", file=sys.stderr)
        return
    text = SETTINGS.read_text(encoding="utf-8")
    lines = text.splitlines(keepends=True)
    widgets = parse_widgets(lines)
    changed = False

    # 1. remover chaves inválidas (de trás para frente para não deslocar índices)
    edits = []
    for wid, w in list(widgets.items()):
        if "settings" not in w or wid.startswith(FRAME_PREFIX): continue
        block = lines[w["settings"] + 1:w["settings_end"]]
        new_block = [ln for ln in block
                     if not (KV_RE.match(ln.rstrip("\n")) and
                             KV_RE.match(ln.rstrip("\n")).group(2) in INVALID_KEYS)]
        if new_block != block:
            edits.append((w["settings"] + 1, w["settings_end"], new_block))
    for start, end, repl in sorted(edits, reverse=True):
        lines[start:end] = repl
        changed = True
    if changed:
        widgets = parse_widgets(lines)

    # 1b. zerar padding interno (conteúdo encosta na moldura)
    edits = []
    for wid, w in widgets.items():
        if wid.startswith(FRAME_PREFIX) or "settings" not in w: continue
        block = lines[w["settings"] + 1:w["settings_end"]]
        new_block = []
        found = False
        for ln in block:
            m = KV_RE.match(ln.rstrip("\n"))
            if m and m.group(2) == "background_padding":
                new_block.append(f"{m.group(1)}background_padding{m.group(3)}{BACKGROUND_PADDING}\n")
                found = True
            else:
                new_block.append(ln)
        if not found and w.get("background") is not False:
            new_block.append(f"        background_padding = {BACKGROUND_PADDING}\n")
        if new_block != block:
            edits.append((w["settings"] + 1, w["settings_end"], new_block))
    for start, end, repl in sorted(edits, reverse=True):
        lines[start:end] = repl
        changed = True
    if changed:
        widgets = parse_widgets(lines)

    # 2. background=false nos excluídos (também de trás para frente)
    edits = []
    for wid, w in widgets.items():
        if wid.startswith(FRAME_PREFIX) or not is_excluded(w.get("type", "")): continue
        if "settings" not in w: continue
        if w.get("background") is not False:
            block = lines[w["settings"] + 1:w["settings_end"]]
            new_block = []
            found = False
            for ln in block:
                m = KV_RE.match(ln.rstrip("\n"))
                if m and m.group(2) == "background":
                    new_block.append(f"{m.group(1)}background = false\n"); found = True
                elif m and m.group(2) == "background_opacity":
                    continue
                else:
                    new_block.append(ln)
            if not found:
                new_block.append("        background = false\n")
            if new_block != block:
                edits.append((w["settings"] + 1, w["settings_end"], new_block))
    for start, end, repl in sorted(edits, reverse=True):
        lines[start:end] = repl
        changed = True
    if changed:
        widgets = parse_widgets(lines)

    # 3. sincronizar o tamanho da moldura nativa dos stickers.
    #    O box é livre: largura e altura podem mudar independentemente.
    #    (A imagem usa fit="stretch" e acompanha o box.)
    for wid, w in widgets.items():
        if w.get("type") != "victor/profiles:sticker" or wid.startswith(FRAME_PREFIX): continue
        bw, bh = w.get("box_width", 0), w.get("box_height", 0)
        if not bw or not bh or bw < 10 or bh < 10: continue
        new_bw, new_bh = round(bw), round(bh)
        if w.get("image_width") == new_bw and w.get("image_height") == new_bh: continue

        s0, s1 = w["settings"] + 1, w["settings_end"]
        block = lines[s0:s1]
        ind = "        "
        found_w = found_h = False
        new_block = []
        for ln in block:
            m = KV_RE.match(ln.rstrip("\n"))
            if m and m.group(2) == "image_width":
                new_block.append(f"{ind}image_width = {new_bw}\n"); found_w = True
            elif m and m.group(2) == "image_height":
                new_block.append(f"{ind}image_height = {new_bh}\n"); found_h = True
            else:
                new_block.append(ln)
        if not found_w: new_block.append(f"{ind}image_width = {new_bw}\n")
        if not found_h: new_block.append(f"{ind}image_height = {new_bh}\n")
        lines[s0:s1] = new_block
        print(f"[~] moldura sincronizada: {wid} {new_bw}x{new_bh}", file=sys.stderr)
        changed = True
    if changed:
        widgets = parse_widgets(lines)

    # 4. determinar molduras necessárias
    needed = {}  # fid -> (wid, w, bw, bh)
    for wid, w in widgets.items():
        if wid.startswith(FRAME_PREFIX) or is_excluded(w.get("type", "")): continue
        bw, bh = w.get("box_width", 0), w.get("box_height", 0)
        if not bw or not bh or bw < 10 or bh < 10: continue
        fid = FRAME_PREFIX + wid
        needed[fid] = (wid, w, bw, bh)

    existing_frames = {wid: w for wid, w in widgets.items() if wid.startswith(FRAME_PREFIX)}

    # 5. remover molduras obsoletas (widget não existe mais ou excluído)
    to_remove = []
    for fid, fw in existing_frames.items():
        target_wid = fid[len(FRAME_PREFIX):]
        if full or fid not in needed:
            to_remove.append(fid)
        else:
            # verificar se tamanho mudou
            _, tw, tbw, tbh = needed[fid]
            fbw, fbh = fw.get("box_width", 0), fw.get("box_height", 0)
            if abs(fbw - tbw) > 0.5 or abs(fbh - tbh) > 0.5:
                to_remove.append(fid)
    # remover todos de uma vez, de trás para frente (índices estáveis)
    ranges = []
    for fid in to_remove:
        fw = widgets.get(fid)
        if not fw: continue
        if "settings" in fw:
            ranges.append((fw["settings"], fw["settings_end"]))
        ranges.append((fw["header"], fw["end"]))
        png = FRAMES_DIR / f"{fid}.png"
        if png.exists(): png.unlink()
        print(f"[-] removida: {fid}", file=sys.stderr)
    for start, end in sorted(set(ranges), reverse=True):
        del lines[start:end]
    if ranges:
        changed = True
        widgets = parse_widgets(lines)
        existing_frames = {wid: w for wid, w in widgets.items() if wid.startswith(FRAME_PREFIX)}

    # 6. gerar molduras novas
    new_stickers = []
    new_ids = []
    for fid, (wid, w, bw, bh) in needed.items():
        if fid in existing_frames and not full: continue
        png = FRAMES_DIR / f"{fid}.png"
        gen_frame_png(png, bw, bh)
        new_ids.append(fid)
        output = w.get("output", "")
        cx, cy = w.get("cx", 0), w.get("cy", 0)
        new_stickers.append(f"""
    [desktop_widgets.widget.{fid}]
    box_height = {bh}
    box_width = {bw}
    cx = {cx}
    cy = {cy}
    output = "{output}"
    placement_height = 1080.0
    placement_width = 1920.0
    rotation = 0.0
    type = "sticker"

        [desktop_widgets.widget.{fid}.settings]
        background = false
        image_path = "{png}"
        opacity = 1.0
""")
        print(f"[+] moldura: {wid} ({w.get('type')}) {int(bw)}x{int(bh)}", file=sys.stderr)

    if new_stickers:
        text = "".join(lines)
        insert_pos = len(text)
        for m in re.finditer(r"(?m)^\[", text):
            header = text[m.start():text.index("\n", m.start()) if "\n" in text[m.start():] else len(text)]
            if not header.startswith("[desktop_widgets"):
                insert_pos = m.start(); break
        text = text[:insert_pos] + "".join(new_stickers) + "\n" + text[insert_pos:]
        lines = text.splitlines(keepends=True)
        changed = True

    # 7. atualizar widget_order
    all_frame_ids = list(existing_frames.keys()) + new_ids
    all_frame_ids = [fid for fid in all_frame_ids if fid in needed or fid in existing_frames]
    # deduplicar
    all_frame_ids = list(dict.fromkeys(all_frame_ids))
    text = "".join(lines)
    m = re.search(r"(widget_order\s*=\s*\[)([^\]]*)(\])", text)
    if m:
        existing = [x.strip().strip('"') for x in m.group(2).split(",") if x.strip()]
        non_frames = [x for x in existing if not x.startswith(FRAME_PREFIX)]
        # manter ordem: widgets originais + molduras no final
        frame_order = [fid for fid in needed if fid in all_frame_ids]
        all_ids = non_frames + frame_order
        new_order = m.group(1) + ", ".join(f'"{x}"' for x in all_ids) + m.group(3)
        if new_order != m.group(0):
            text = text[:m.start()] + new_order + text[m.end():]
            changed = True
    elif all_frame_ids:
        order_line = "widget_order = [" + ", ".join(f'"{x}"' for x in all_frame_ids) + "]\n"
        text = re.sub(r"(\[desktop_widgets\]\n)", r"\1" + order_line, text, count=1)
        changed = True

    if changed:
        # escrita atomica: nunca deixa o arquivo pela metade
        tmp = SETTINGS.with_suffix(".toml.tmp")
        tmp.write_text(text, encoding="utf-8")
        os.replace(tmp, SETTINGS)
        print("\nconfig atualizada. recarregando...", file=sys.stderr)
        try:
            subprocess.run(["noctalia", "msg", "config-reload"],
                           capture_output=True, timeout=10)
        except Exception as e:
            print(f"[!] config-reload falhou: {e}", file=sys.stderr)
    else:
        print("nada a mudar: molduras já estão corretas", file=sys.stderr)


if __name__ == "__main__":
    main()
